	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/Qt_GUI_with_Arduino/bin || mkdir -p $(INSTALL_ROOT)/opt/Qt_GUI_with_Arduino/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/Qt_GUI_with_Arduino/bin/Qt_GUI_with_Arduino.app
	
	$(QINSTALL) Qt_GUI_with_Arduino.app $(INSTALL_ROOT)/opt/Qt_GUI_with_Arduino/bin/Qt_GUI_with_Arduino.app
	-$(STRIP) $(INSTALL_ROOT)/opt/Qt_GUI_with_Arduino/bin/Qt_GUI_with_Arduino.app/Contents/MacOS/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/Qt_GUI_with_Arduino/bin/Qt_GUI_with_Arduino.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/Qt_GUI_with_Arduino/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

